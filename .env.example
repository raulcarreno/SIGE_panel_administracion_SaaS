# Panel registry PostgreSQL
DATABASE_URL=postgresql://sige_panel:sige_panel@localhost:5433/sige_panel

# AES-256 key for encrypting CONTROL_API_TOKEN in registry (min 16 chars)
PANEL_SECRETS_KEY=change-me-32-char-panel-secrets-key

# Superadmin JWT (min 32 chars)
SUPERADMIN_JWT_SECRET=change-me-superadmin-jwt-secret-min-32-chars

# Google Auth para panel admin (mismo patrón que carpinteria)
# Proyecto GCP: sige-saas — npm run google:oauth:setup
# Console: https://console.cloud.google.com/auth/clients/create?project=sige-saas
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Comma-separated allowlist
SUPERADMIN_ALLOWED_EMAILS=admin@example.com

# Local dev login without Google (never enable in production)
SUPERADMIN_DEV_LOGIN=true

# Monolith local dev uses API on 3001; panel API uses 3002 to avoid conflict
PORT=3002
API_PORT=3002
NODE_ENV=development

# Optional: production CORS origin
PANEL_ORIGIN=http://localhost:5173

# Tenant versioning / GitHub + GKE deploy
GITHUB_TOKEN=
GITHUB_ERP_REPO=raulcarreno/SIGE_monolito
GITHUB_WEB_REPO=raulcarreno/SIGE_monolito_web
GCP_PROJECT_ID=findspo-core
GKE_CLUSTER=kbnt-prd-1
GKE_REGION=europe-southwest1
GKE_NAMESPACE=sige-saas-prod
ARTIFACT_REGISTRY=europe-southwest1-docker.pkg.dev/findspo-core/fraian-saas
# Absolute path to workspace (for gcloud builds submit from panel worker)
SIGE_WORKSPACE_ROOT=

# Tenant domains (GKE Ingress / ManagedCertificate; DNS IONOS is manual)
DNS_ZONE_NAME=findspo.com
SAAS_BASE_DOMAIN=findspo.com
# Optional; if empty the panel reads the platform Ingress loadBalancer IP
INGRESS_IP=
PLATFORM_INGRESS_NAME=sige-platform
# Isolated tenants (default): Ingress/deploy targets sige-erp-{slug} / sige-web-{slug}
# PLATFORM_ERP_SERVICE_TEMPLATE=sige-erp-{slug}
# PLATFORM_WEB_SERVICE_TEMPLATE=sige-web-{slug}
# Legacy shared demo backends only:
# PLATFORM_TENANT_ISOLATED=0
# PLATFORM_ERP_SERVICE=sige-erp
# PLATFORM_WEB_SERVICE=sige-web

