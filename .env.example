# Panel registry PostgreSQL
DATABASE_URL=postgresql://sige_panel:sige_panel@localhost:5433/sige_panel

# AES-256 key for encrypting CONTROL_API_TOKEN in registry (min 16 chars)
PANEL_SECRETS_KEY=change-me-32-char-panel-secrets-key

# Superadmin JWT (min 32 chars)
SUPERADMIN_JWT_SECRET=change-me-superadmin-jwt-secret-min-32-chars

# Google OAuth Web client ID
GOOGLE_CLIENT_ID=

# Comma-separated allowlist
SUPERADMIN_ALLOWED_EMAILS=admin@example.com

PORT=3001
API_PORT=3001
NODE_ENV=development

# Optional: production CORS origin
PANEL_ORIGIN=http://localhost:5173
